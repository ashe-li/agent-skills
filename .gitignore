# Playwright CLI runtime artifacts
.playwright-cli/
.playwright-mcp/

# OS / editor
.DS_Store
*.swp

# Local Claude Code config (install-environment-specific)
.claude/

# Secrets
.env
.env.*
!.env.example

# Dependencies / caches
node_modules/
__pycache__/
*.pyc
*.pyo

# Logs
*.log
# 測試 fixture 的 log 樣本要進版控（少了它們 CI 的測試會找不到檔）
!scripts/tests/fixtures/**/*.log
